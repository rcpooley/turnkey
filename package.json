{
  "name": "@rcpooley/turnkey",
  "version": "0.1.0",
  "description": "API tokens, scoped permissions, browser sessions and issued credentials that a service keeps in its own database.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcpooley/turnkey.git"
  },
  "keywords": [
    "auth",
    "tokens",
    "api-tokens",
    "permissions",
    "sessions",
    "postgres",
    "mysql",
    "sqlite",
    "dolt"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./express": {
      "types": "./dist/adapters/express.d.ts",
      "default": "./dist/adapters/express.js"
    },
    "./node": {
      "types": "./dist/adapters/node.d.ts",
      "default": "./dist/adapters/node.js"
    },
    "./fetch": {
      "types": "./dist/adapters/fetch.d.ts",
      "default": "./dist/adapters/fetch.js"
    },
    "./quiver": {
      "types": "./dist/quiver.d.ts",
      "default": "./dist/quiver.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build --silent && node --test --test-concurrency=1 test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "typescript": "^5.9.3"
  }
}
